FROM mcr.microsoft.com/devcontainers/base:2-debian12 AS toolchain

WORKDIR /tmp
ARG BIN=/usr/local/bin
ARG COMPD=/etc/bash_completion.d/

ARG AWSCLI_URL=https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip
RUN curl -fsSL "${AWSCLI_URL}" -o awscliv2.zip && \
    unzip -q awscliv2.zip && \
    ./aws/install --bin-dir ${BIN} --install-dir /usr/local/aws-cli && \
    echo 'complete -C /usr/local/bin/aws_completer aws' > "${COMPD}"/aws

# hadolint
ARG HADOLINT_URL="https://github.com/hadolint/hadolint/releases/download/v2.15.1/hadolint-Linux-x86_64"
RUN curl -fsSL "${HADOLINT_URL}" -o hadolint && \
    install -m 755 hadolint ${BIN}/hadolint

# terraform
RUN echo 'complete -C /usr/bin/terraform terraform' > ${COMPD}/terraform

# diff-highlight
WORKDIR /usr/share/doc/git/contrib/diff-highlight
RUN make && install -m 755 diff-highlight ${BIN}/diff-highlight

# =====================================================================================================

FROM mcr.microsoft.com/devcontainers/python:3.14-bookworm

ARG HASHICORP_KEYRING_PATH=/usr/share/keyrings/hashicorp-archive-keyring.gpg
ARG HASHICORP_APT_URL=https://apt.releases.hashicorp.com
RUN curl -sSL "${HASHICORP_APT_URL}/gpg" | gpg --dearmor > "${HASHICORP_KEYRING_PATH}" &&\
    VERSION_CODENAME=$(. /etc/os-release && echo "${VERSION_CODENAME}") &&\
    echo "deb [signed-by=${HASHICORP_KEYRING_PATH}] ${HASHICORP_APT_URL} ${VERSION_CODENAME} main" > \
    /etc/apt/sources.list.d/hashicorp.list

RUN DEBIAN_FRONTEND=noninteractive \
    apt-get -qq update && \
    apt-get -y install --no-install-recommends \
    # utilities
    peco \
    ripgrep \
    vim \
    # network tools
    curl \
    dnsutils \
    netcat-openbsd \
    net-tools \
    iproute2 \
    iputils-ping \
    tcpdump \
    traceroute \
    tshark \
    wget \
    # IaC`
    terraform \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 日本語化
ENV LANG=ja_JP.UTF-8
ENV LANGUAGE=ja_JP:ja
ENV LC_ALL=ja_JP.UTF-8
ENV TZ=Asia/Tokyo
RUN sed -i -e 's/# ja_JP.UTF-8 UTF-8/ja_JP.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo $TZ > /etc/timezone

# tools
# /usr/local/bin/awsは/usr/local/aws-cli/v2/current/bin/aws*へのシンボリックリンクである。
# COPY --from=toolchain /usr/local/bin/aws /usr/local/bin/awsはシンボリックリンク先まで追ってコピーする挙動を取る。
# そのため、マルチステージコンテナからコピーしたければ、/usr/local/bin全体をコピーするしかない。
COPY --from=toolchain /usr/local/bin /usr/local/bin
COPY --from=toolchain /usr/local/aws-cli /usr/local/aws-cli
COPY --from=toolchain /etc/bash_completion.d /etc/bash_completion.d

COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -q -r /tmp/requirements.txt
